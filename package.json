{
  "name": "deepresearch-se",
  "private": true,
  "type": "module",
  "description": "Deep-research Cloudflare Worker. No build step \u2014 deployed via `npx wrangler deploy`, reading src/ as plain JS. This package.json exists only to run the unit test suite and the type-checker (both dev-only; neither is part of the deploy).",
  "scripts": {
    "test": "node --test src/*.test.js public/js/*.test.js public/app-kit/*.test.js public/games/*/js/*.test.js sdk/*.test.mjs scripts/*.test.mjs scripts/*/*.test.mjs tests/*.test.js tests/pygram/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.public.json --noEmit",
    "coverage": "node scripts/coverage.mjs",
    "coverage:check": "node scripts/coverage.mjs --check",
    "bundle": "node scripts/bundle-source.mjs",
    "bundle:rag": "node scripts/bundle-source-rag.mjs",
    "bundle:docs": "node scripts/bundle-docs.mjs",
    "bundle:docs-rag": "node scripts/bundle-docs-rag.mjs",
    "fetch:owasp": "node scripts/fetch-owasp.mjs",
    "bundle:owasp-rag": "node scripts/bundle-owasp-rag.mjs",
    "bundle:aadr": "node scripts/aadr-build.mjs",
    "verify:owasp": "node scripts/verify-owasp-quotes.mjs",
    "outrospect": "node scripts/outrospect-scan.mjs",
    "pulse": "node scripts/build-pulse.mjs",
    "pulse:timeline": "node scripts/build-pulse-timeline.mjs",
    "pulse:size": "node scripts/build-pulse-size.mjs",
    "pulse:all": "npm run pulse && npm run pulse:timeline && npm run pulse:size",
    "capture": "node tests/capture.mjs",
    "capture:edit": "node scripts/capture-edit.mjs",
    "capture:topup": "node scripts/capture-topup.mjs",
    "proof:agents": "node scripts/agent-proof.mjs",
    "mcp:probe": "node scripts/mcp-probe.mjs",
    "pygram:conformance": "node tests/pygram/conformance.mjs",
    "pygram:harvest": "node scripts/pygram-capture/harvest.mjs",
    "arxiv:harvest": "node scripts/arxiv-harvest.mjs",
    "arxiv:sets": "node scripts/arxiv-oai-sets.mjs",
    "arxiv:corpus": "node scripts/arxiv-corpus.mjs",
    "arxiv:goldset": "node scripts/arxiv-goldset.mjs",
    "arxiv:index": "node scripts/arxiv-index.mjs",
    "arxiv:search": "node scripts/arxiv-search.mjs",
    "arxiv:eval": "node scripts/arxiv-eval.mjs",
    "arxiv:fulltext": "node scripts/arxiv-fulltext.mjs",
    "arxiv:fulltext-eval": "node scripts/arxiv-fulltext-eval.mjs",
    "rag:eval": "node scripts/rag-eval.mjs",
    "pubmed:harvest": "node scripts/pubmed-harvest.mjs",
    "pubmed:enumerate": "node scripts/pubmed-enumerate.mjs",
    "pubmed:corpus": "node scripts/pubmed-corpus.mjs",
    "pubmed:vectorize": "node scripts/pubmed-vectorize.mjs",
    "pubmed:eval": "node scripts/rag-eval.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "cheerio": "^1.2.0",
    "typescript": "latest"
  }
}
