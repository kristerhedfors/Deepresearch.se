#!/usr/bin/env bash
# Pre-commit git hook (security register P-2): block a COMMIT that would add a
# credential-shaped token to the PUBLIC, auto-deploying repo. Runs
# scripts/scan-secrets over the staged diff, so a secret is stopped before it
# ever enters history — rewriting is never needed when this fires. The
# pre-push hook remains the second line, covering commits made while the
# hooks were inactive (a fresh clone before scripts/install-git-hooks ran).
#
# Activated by scripts/install-git-hooks (sets core.hooksPath=.githooks); the
# SessionStart hook in .claude/settings.json runs that automatically in
# remote-session clones.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# pygram-capture: stage the session's own sightings file, if the Stop hook
# published one (tests/pygram/sightings/<session>.jsonl — see
# .claude/hooks/pygram-harvest.sh). These containers are ephemeral, so evidence
# that is not committed is evidence that is lost, and 17 of the 19 sessions
# before this existed lost all of theirs.
#
# Deliberately narrow: ONE directory, and only files it ADDS, so it cannot
# alter a diff the session meant to make or conflict with another branch. It
# runs BEFORE scan-secrets on purpose, so what it stages is scanned like
# anything else. PYGRAM_CAPTURE=0 opts out, as it does for the rest of capture.
if [ "${PYGRAM_CAPTURE:-1}" != "0" ] && [ -d "$repo_root/tests/pygram/sightings" ]; then
  git -C "$repo_root" add -- tests/pygram/sightings >/dev/null 2>&1 || true
fi

if ! "$repo_root/scripts/scan-secrets" --staged; then
  echo "pre-commit: BLOCKED — a credential-shaped token is in the staged diff." >&2
  echo "pre-commit: unstage/replace it, or (verified false positive) commit with --no-verify." >&2
  exit 1
fi
exit 0
