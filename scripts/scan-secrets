#!/usr/bin/env bash
# Mechanical secret-leak scan for THIS repo (security register P-2). The repo is
# PUBLIC and auto-deploys from main, so a committed credential is published and
# deployed instantly — this is the last mechanical gate before that happens.
# The credential pattern set is the canonical one from the security-posture
# skill (.claude/skills/security-posture/SKILL.md §1): OpenAI sk-, Berget
# sk_ber_, Groq gsk_, Anthropic sk-ant-, AWS AKIA, GitHub ghp_/github_pat_,
# Google AIza, Slack xox*, and PEM private-key blocks. Keep the two in sync.
#
# Matches are REDACTED in the output (provider prefix + length only) so running
# the scanner never itself prints a full secret into a log or terminal buffer.
#
# Usage:
#   scripts/scan-secrets                 scan the working tree's tracked+staged files
#   scripts/scan-secrets --staged        scan the staged diff (pre-commit/pre-push)
#   scripts/scan-secrets --range A..B     scan the added lines of a commit range
#
# Exit status: 0 = PASS (nothing matched), 1 = FAIL (a token matched),
#              2 = bad arguments. Used non-interactively by .githooks/pre-push.
set -euo pipefail

# Canonical credential patterns (security-posture skill §1). Constructed so the
# pattern text itself does NOT self-match: every literal prefix is immediately
# followed by a bracketed character class, so this file scans clean.
PATTERN='(sk-[A-Za-z0-9_-]{24,}|sk_ber_[A-Za-z0-9_-]{8,}|gsk_[A-Za-z0-9]{16,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{20,}|gh[sour]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AIza[0-9A-Za-z_-]{35}|GOCSPX-[A-Za-z0-9_-]{10,}|hf_[A-Za-z0-9]{20,}|xox[bpoas]-[A-Za-z0-9-]{10,}|eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{5,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'

# A pattern only catches a secret with a recognisable SHAPE, and the most
# dangerous credentials in these containers have none: a Cloudflare API token is
# 53 characters of unprefixed base62, CLAUDE_CODE_MESSAGING_TOKEN is 32,
# BASIC_AUTH_PASS is whatever it is. No regex separates those from a hash or a
# base64 fixture, and one tuned to try would fail every build.
#
# This scanner runs inside the container that HOLDS those secrets, so it does not
# have to guess — it matches the literal value. Exact, so it cannot false-positive
# on anything but the secret itself, and it is the only check that covers a
# shapeless credential. Values are never printed: a hit reports the VARIABLE NAME.
#
# Built as a grep -F pattern file rather than an argument so no secret ever
# appears in a command line, a process listing, or the shell's history.
ENV_SECRET_FILE="$(mktemp)"
ENV_SECRET_NAMES="$(mktemp)"
trap 'rm -f "$ENV_SECRET_FILE" "$ENV_SECRET_NAMES"' EXIT
env | while IFS= read -r line; do
  name="${line%%=*}"
  value="${line#*=}"
  case "$name" in
    *[Kk][Ee][Yy]*|*[Tt][Oo][Kk][Ee][Nn]*|*[Ss][Ee][Cc][Rr][Ee][Tt]*|*[Pp][Aa][Ss][Ss]*|*[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]*|*[Aa][Uu][Tt][Hh]*|*[Dd][Ss][Nn]*|*[Ww][Ee][Bb][Hh][Oo][Oo][Kk]*) : ;;
    *) continue ;;
  esac
  # Too short to be a credential; a path or a bare number is not one either.
  [ "${#value}" -ge 12 ] || continue
  case "$value" in /*) continue ;; esac
  printf '%s\n' "$value" | grep -qE '^[0-9]+$' && continue
  # A credential is one opaque token. These shapes never are, and all of them
  # are live in this container under credential-MATCHING names — treating one as
  # a secret would block every commit whose docs happen to mention it.
  case "$value" in
    *[[:space:]]*) continue ;;                       # a sentence or a flag list
    *"://"*) continue ;;                             # GIT_CONFIG_KEY_1 is a URL
    proxy-injected|placeholder|changeme|redacted|not-set|unset|none) continue ;;
  esac
  # A dotted lowercase config key, e.g. GIT_CONFIG_KEY_0 = credential.interactive
  printf '%s\n' "$value" | grep -qE '^[a-z][a-z0-9]*(\.[a-z0-9]+)+$' && continue
  # An EMAIL ADDRESS is never a credential, and the `*AUTH*` name pattern above
  # matches `AUTHOR`: GIT_AUTHOR_EMAIL / GIT_COMMITTER_EMAIL are selected by
  # name and hold a public address. The owner's is already committed in nine
  # tracked files INCLUDING public/introspect/source-snapshot.json, which is
  # regenerated on nearly every change — so where these are set this refused
  # almost every commit, and the way round it is --no-verify, which turns the
  # gate off entirely. A false positive that teaches people to bypass the
  # scanner is worse than no scanner.
  printf '%s\n' "$value" | grep -qE '^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$' && continue
  printf '%s\n' "$value" >> "$ENV_SECRET_FILE"
  printf '%s\t%s\n' "${#value}" "$name" >> "$ENV_SECRET_NAMES"
done

mode="worktree"
range=""

while [ $# -gt 0 ]; do
  case "$1" in
    --staged) mode="staged" ;;
    --range) mode="range"; range="${2:-}"; shift ;;
    -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

if [ "$mode" = "range" ] && [ -z "$range" ]; then
  echo "--range needs a commit range, e.g. --range origin/main..HEAD" >&2
  exit 2
fi

cd "$(git rev-parse --show-toplevel)"

# redact <token> -> "<4-char prefix>…[REDACTED N chars]" (the prefix is the
# non-secret provider marker; the secret body is never printed).
redact() {
  local tok="$1"
  printf '%s…[REDACTED %d chars]' "${tok:0:4}" "${#tok}"
}

# emit prints one "location<TAB>token" line per match for the selected mode.
emit() {
  case "$mode" in
    worktree)
      # On-disk content of every tracked-or-staged file (git ls-files reads the
      # index, so staged-new files are included alongside working-tree edits).
      git ls-files -z | while IFS= read -r -d '' f; do
        [ -f "$f" ] || continue
        grep -aonE "$PATTERN" -- "$f" 2>/dev/null | while IFS= read -r hit; do
          printf '%s\t%s\n' "$f:${hit%%:*}" "${hit#*:}"
        done || true
      done
      ;;
    staged|range)
      # Only ADDED lines (the diff about to enter history), attributed to the
      # file from the most recent +++ header. -U0 keeps context out of scope.
      local diffcmd
      if [ "$mode" = "staged" ]; then diffcmd=(git diff --cached -U0); else diffcmd=(git diff -U0 "$range"); fi
      "${diffcmd[@]}" | awk '
        /^\+\+\+ /{ f=$2; sub(/^b\//,"",f); next }
        /^\+/ && !/^\+\+\+/ { print f "\t" substr($0,2) }
      ' | while IFS=$'\t' read -r f content; do
        printf '%s\n' "$content" | grep -aoE "$PATTERN" 2>/dev/null | while IFS= read -r tok; do
          printf '%s\t%s\n' "$f" "$tok"
        done || true
      done
      ;;
  esac
}

# emit_env reports content containing the LITERAL value of a live credential in
# this environment. One bulk grep -F pass finds candidate files; only on a hit
# (normally never) does it loop per-secret to name the variable. The value is
# never printed — the report names the VARIABLE.
emit_env() {
  [ -s "$ENV_SECRET_FILE" ] || return 0
  local hits name i value
  case "$mode" in
    worktree)
      hits="$(git ls-files -z | xargs -0 grep -laFf "$ENV_SECRET_FILE" 2>/dev/null || true)"
      [ -n "$hits" ] || return 0
      printf '%s\n' "$hits" | while IFS= read -r f; do
        [ -n "$f" ] || continue
        i=0
        while IFS= read -r value; do
          i=$((i + 1))
          grep -qaF -- "$value" "$f" 2>/dev/null || continue
          name="$(sed -n "${i}p" "$ENV_SECRET_NAMES" | cut -f2)"
          printf '%s\t%s\n' "$f" "ENVSECRET:$name"
        done < "$ENV_SECRET_FILE"
      done
      ;;
    staged|range)
      local diffcmd
      if [ "$mode" = "staged" ]; then diffcmd=(git diff --cached -U0); else diffcmd=(git diff -U0 "$range"); fi
      local added
      added="$("${diffcmd[@]}" | awk '/^\+\+\+ /{ f=$2; sub(/^b\//,"",f); next } /^\+/ && !/^\+\+\+/ { print f "\t" substr($0,2) }')"
      [ -n "$added" ] || return 0
      printf '%s\n' "$added" | while IFS=$'\t' read -r f content; do
        i=0
        while IFS= read -r value; do
          i=$((i + 1))
          case "$content" in *"$value"*) ;; *) continue ;; esac
          name="$(sed -n "${i}p" "$ENV_SECRET_NAMES" | cut -f2)"
          printf '%s\t%s\n' "$f" "ENVSECRET:$name"
        done < "$ENV_SECRET_FILE"
      done
      ;;
  esac
}

found=0
env_found=0
while IFS=$'\t' read -r loc tok; do
  [ -z "$loc" ] && continue
  found=$((found + 1))
  case "$tok" in
    ENVSECRET:*)
      env_found=$((env_found + 1))
      printf '  %-48s  LIVE VALUE OF $%s\n' "$loc" "${tok#ENVSECRET:}"
      ;;
    *) printf '  %-48s  %s\n' "$loc" "$(redact "$tok")" ;;
  esac
done < <(emit; emit_env)

echo
if [ "$found" -gt 0 ]; then
  echo "FAIL: $found credential(s) matched ($mode scan)."
  if [ "$env_found" -gt 0 ]; then
    echo "      $env_found of them is the LIVE VALUE of a credential in this environment."
    echo "      That is not a shape guess — it is an exact match. Treat it as burned."
  fi
  echo
  echo "ROTATION RUNBOOK — a real secret here is already burned:"
  echo "  1. Rotate the credential AT THE PROVIDER FIRST (repo is public +"
  echo "     auto-deploys — assume compromised the moment it is pushed)."
  echo "  2. THEN rewrite history to purge it (git filter-repo / BFG)."
  echo "  3. Log the incident in SECURITY-RISKS.md's History log."
  echo "  (False positive? Use an obviously-fake placeholder instead.)"
  exit 1
fi
echo "PASS: no credential-shaped tokens found ($mode scan)."
exit 0
